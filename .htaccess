# Redirect neosoftix.com -> https://www.neosoftix.com (and force HTTPS)
<IfModule mod_rewrite.c>
RewriteEngine On

# Non-www -> www (keeps path and query string)
RewriteCond %{HTTP_HOST} ^neosoftix\.com$ [NC]
RewriteRule ^(.*)$ https://www.neosoftix.com/$1 [R=301,L]

# HTTP -> HTTPS on www
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://www.neosoftix.com/$1 [R=301,L]
</IfModule>
